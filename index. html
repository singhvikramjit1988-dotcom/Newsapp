// ── EXPLORE ───────────────────────────────────────────────────────────
let exploreStories = [];
let si = 0; // story index
let pi = 0; // page index
const PLABELS = ["Story","Key Facts","More Facts","Context","Source"];
let touchX=0, touchY=0;

async function loadExplore() {
  exploreStories = MOCK_EXPLORE; si=0; pi=0;
  renderExploreDots(); renderExploreCard();
  const raw = await askClaude([{role:"user",content:"Give me 5 diverse interesting news stories from today covering different worldwide topics."}],
    "You are a news curator. Use web search. Return ONLY a valid JSON array of 5 objects: [{title,tag,source,summary,context,points}] where points is array of 5 strings. No markdown, just JSON.");
  const data = tryJSON(raw);
  if(data&&data.length){exploreStories=data; si=0; pi=0; renderExploreDots(); renderExploreCard();}
}

function renderExploreDots(){
  document.getElementById("story-dots").innerHTML = exploreStories.map((_, i)=>`
    <div class="sdot" onclick="jumpStory(${i})" style="background:${i<si?'var(--gold)':i===si?'var(--accent)':'var(--soft)'}"></div>`).join("");
}

function renderPageBars(){
  const s = exploreStories[si]; if(!s) return;
  const tc = TCOLORS[s.tag]||"var(--accent)";
  document.getElementById("page-bars").innerHTML = PLABELS.map((_,i)=>`
    <div class="pbar" onclick="jumpPage(${i})" style="background:${i<pi?'var(--gold)':i===pi?tc:'var(--soft)'}"></div>`).join("");
}

function renderExploreCard(){
  const s = exploreStories[si]; if(!s) return;
  const tc = TCOLORS[s.tag]||"var(--accent)";
  renderPageBars();
  document.getElementById("ex-tag").textContent = s.tag||"";
  document.getElementById("ex-tag").style.color = tc;
  document.getElementById("ex-tag").style.background = tc+"20";
  document.getElementById("ex-source").textContent = s.source||"";
  document.getElementById("ex-page-label").textContent = `${PLABELS[pi]} ${pi+1}/5`;
  document.getElementById("story-counter").textContent = `${si+1}/${exploreStories.length}`;

  // next button style
  const nb = document.getElementById("next-page-btn");
  nb.style.background = pi===4?"var(--accent)":tc+"25";
  nb.style.color = pi===4?"var(--bg)":tc;
  nb.textContent = pi===4?"Next ↓":"More →";

  // content
  const pts = s.points||[];
  const half = Math.ceil(pts.length/2);
  let html = "";
  if(pi===0){
    html=`<h2 class="serif" style="font-size:21px;color:var(--text);margin-bottom:13px;line-height:1.38">${s.title}</h2>
    <p style="font-size:13px;color:var(--muted);line-height:1.75">${s.summary}</p>
    <p style="font-size:11px;color:var(--muted);margin-top:16px;opacity:0.6">Swipe left for key facts →</p>`;
  } else if(pi===1){
    html=`<p style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:14px">Key Facts</p>`;
    pts.slice(0,half).forEach((pt,i)=>{ html+=bulletItem(i+1,pt,tc); });
  } else if(pi===2){
    html=`<p style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:14px">More Details</p>`;
    const rest = pts.slice(half).length ? pts.slice(half) : ["More details are emerging as this story develops."];
    rest.forEach((pt,i)=>{ html+=bulletItem(half+i+1,pt,tc); });
  } else if(pi===3){
    html=`<p style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:14px">Why It Matters</p>
    <p class="serif" style="font-size:15px;color:var(--text);line-height:1.8">${s.context||s.summary}</p>`;
  } else if(pi===4){
    html=`<p style="font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.1em;margin-bottom:14px">Source</p>
    <div style="background:var(--soft);border-radius:10px;padding:14px;margin-bottom:13px">
      <p class="serif" style="font-size:14px;color:var(--accent);font-weight:700;margin-bottom:3px">${s.source}</p>
      <p style="font-size:11px;color:var(--muted)">Verified news source</p>
    </div>
    <button onclick="switchTab('agent',document.querySelectorAll('.tab')[1])" style="width:100%;padding:12px;border-radius:10px;background:${tc}18;border:1px solid ${tc}44;color:${tc};font-size:13px;font-weight:700;cursor:pointer;font-family:inherit">
      Ask Agent to Track This →
    </button>`;
  }
  const ec = document.getElementById("explore-content");
  ec.style.animation = "none";
  ec.offsetHeight; // reflow
  ec.style.animation = "fu 0.2s ease";
  ec.innerHTML = html;
}

function bulletItem(n, text, tc){
  return `<div style="display:flex;gap:11px;align-items:flex-start;margin-bottom:13px">
    <span style="width:22px;height:22px;border-radius:50%;background:${tc}22;color:${tc};font-size:10px;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0">${n}</span>
    <p style="color:var(--text);font-size:13px;line-height:1.6;margin:0">${text}</p>
  </div>`;
}

function nextPage()  { if(pi<4){pi++;} else nextStory(); renderPageBars(); renderExploreCard(); }
function prevPage()  { if(pi>0){pi--;} renderPageBars(); renderExploreCard(); }
function nextStory() { if(si<exploreStories.length-1){si++;pi=0;} else{si=0;pi=0;} renderExploreDots(); renderPageBars(); renderExploreCard(); }
function prevStory() { if(si>0){si--;pi=0;} renderExploreDots(); renderPageBars(); renderExploreCard(); }
function jumpStory(i){ si=i;pi=0; renderExploreDots(); renderPageBars(); renderExploreCard(); }
function jumpPage(i) { pi=i; renderPageBars(); renderExploreCard(); }

// Touch swipe for explore
document.getElementById("page-explore").addEventListener("touchstart",e=>{ touchX=e.touches[0].clientX; touchY=e.touches[0].clientY; },{passive:true});
document.getElementById("page-explore").addEventListener("touchend",e=>{
  const dx=touchX-e.changedTouches[0].clientX;
  const dy=touchY-e.changedTouches[0].clientY;
  if(Math.abs(dx)>Math.abs(dy)&&Math.abs(dx)>35){ dx>0?nextPage():prevPage(); }
  else if(Math.abs(dy)>Math.abs(dx)&&Math.abs(dy)>35){ dy>0?nextStory():prevStory(); }
},{passive:true});
</script>
